{
  "$schema": "node_modules/albatros/schema.json",
  "name": "nashepo.info",
  "version": "0.2.0",
  "displayName": "НашеПО · Поиск",
  "description": "Сквозной поиск по всем моделям проекта с подсветкой и переходом камеры",
  "author": {
    "name": "НашеПО",
    "url": "https://nashepo.ru/"
  },
  "bugs": {
    "url": "https://t.me/RoburFan"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/BorisMoniac/360.info.git"
  },
  "homepage": "https://borismoniac.github.io/360.info/",
  "license": "MIT",
  "keywords": [
    "поиск",
    "IFC",
    "SMDX",
    "свойства",
    "Топоматик 360"
  ],
  "main": "src/index.ts",
  "sdk": "^1.4.0",
  "scripts": {
    "prebuild": "node scripts/clean-build.mjs",
    "build": "albatros-cli build",
    "postbuild": "node scripts/create-publish-index.mjs",
    "serve": "albatros-cli serve",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "albatros": "1.4.2",
    "typescript": "~5.9.3"
  },
  "albatros": {
    "actions": {
      "search_open": {
        "label": "Поиск",
        "description": "Открыть панель поиска по проекту",
        "cmd": "open",
        "icon": "search",
        "flags": "128"
      },
      "search_quick": {
        "label": "Быстрый поиск",
        "description": "Ввести значение и сразу подсветить все совпадения",
        "cmd": "quick",
        "icon": "manage_search",
        "flags": "128"
      },
      "search_clear": {
        "label": "Снять выделение",
        "description": "Убрать подсветку найденных элементов",
        "cmd": "clear",
        "icon": "deselect",
        "flags": "128"
      }
    },
    "menu": [
      {
        "label": "НашеПО · Поиск",
        "submenu": [
          {
            "action": "search_open"
          },
          {
            "action": "search_quick"
          },
          {
            "tag": "s"
          },
          {
            "action": "search_clear"
          }
        ]
      }
    ],
    "pages": [
      {
        "tag": "nashepo_tools",
        "label": "НашеПО",
        "groups": [
          {
            "tag": "nashepo_search",
            "label": "Поиск",
            "items": [
              {
                "tag": "bt",
                "action": "search_open"
              },
              {
                "tag": "bt",
                "action": "search_quick"
              },
              {
                "tag": "bt",
                "action": "search_clear"
              }
            ]
          }
        ]
      }
    ],
    "viewsContainers": {
      "nashepo": {
        "label": "НашеПО",
        "icon": "apps",
        "container": "left"
      }
    },
    "views": {
      "search_panel": {
        "label": "Поиск",
        "type": "defined",
        "cmd": "mount",
        "container": "nashepo",
        "icon": "search",
        "expanded": true
      }
    }
  }
}
